  { slug: 'time', name: 'Time' },
  { slug: 'data', name: 'Data' },
  { slug: 'interface', name: 'Interface' },
] as const;

function licenseAnswer(lib: LibraryMeta): string {
  switch (lib.license) {
    case 'MIT':
      return `Yes. ${lib.fullName} is released under the MIT license, which permits unrestricted commercial use, modification, and distribution. No attribution is required, though it is appreciated. This makes ${lib.name} one of the safest icon libraries to use in commercial SaaS products, client work, and proprietary applications.`;
    case 'Apache 2.0':
      return `Yes. ${lib.fullName} is released under Apache 2.0, which permits commercial use, modification, and distribution and includes an express patent grant from the licensor. Attribution is not required for ordinary use, but you should not use the icons in a way that implies the licensor endorses your product.`;
    case 'ISC':
      return `Yes. ${lib.fullName} is released under the ISC license, a permissive license functionally equivalent to MIT. Commercial use, modification, and distribution are all permitted with no attribution requirement, making it safe for client work, commercial SaaS, and proprietary products.`;
    case 'CC BY 4.0':
      return `Yes, with one condition. ${lib.fullName} is released under CC BY 4.0, which permits commercial use and modification but requires attribution to the original creator. Most products satisfy this with a credit line in the footer, an about page, or the project README. If providing credit is not practical for your product, use an MIT or Apache 2.0 library instead.`;
    case 'CC0 1.0':
      return `Yes. ${lib.fullName} is released under CC0 1.0, which is effectively a public domain dedication — commercial use, modification, and redistribution are all permitted with no attribution required. Note that the underlying brand marks remain trademarks of their respective owners even though the icon files are CC0.`;
    default:
      return `Yes. ${lib.fullName} is released under the ${lib.license} license, which permits commercial use. Check the library's own license page for attribution requirements before shipping.`;
  }
}

function firstSentence(html: string): string {
  const text = html.replace(/<[^>]+>/g, '');
  const m = text.match(/^[^.]+\./);
  return (m ? m[0] : text.slice(0, 140)).trim();
}

const { lib, allLibraries } = Astro.props;
const copy = LIB_COPY[lib.slug];
const libBySlug = new Map(allLibraries.map((l) => [l.slug, l]));
const peerRows = copy.peers
  .map((s) => libBySlug.get(s))
  .filter((x): x is LibraryMeta => Boolean(x));

const otherLibs = [
  ...peerRows,
  ...allLibraries
    .filter((l) => l.slug !== lib.slug && !copy.peers.includes(l.slug))
    .sort((a, b) => b.countNum - a.countNum),
].slice(0, 8);

const faqs: [string, string][] = [
  [`What is ${lib.fullName}?`, copy.about[0]],
  [`Is ${lib.fullName} free for commercial use?`, licenseAnswer(lib)],
  [
    `How do I use ${lib.name} icons in React?`,
    `Install the package with <code>npm install ${lib.npm}</code>, then import icons as components. Every ${lib.name} page on IconStash shows the exact import statement and usage snippet for that specific icon in the Code tab, so you can copy working code without checking the docs. Tree-shakeable packages mean your bundler only includes the icons you actually import.`,
  ],
  [
    `Can I download ${lib.name} icons as PNG?`,
    `Yes. Open any ${lib.name} icon on IconStash and use the Download PNG button to export at 16, 32, 64, 128, 256, or 512 pixels. The PNG is generated client-side from the original vector, so it stays crisp at every size. You can also copy the raw SVG markup, export a React component, or build an SVG sprite without installing anything.`,
  ],
  ...copy.faq,
];

const canonical = `${SITE_URL}/library/${lib.slug}/`;
const title = `${lib.fullName} — ${lib.count} Free ${lib.license} SVG Icons | IconStash`;
const rawDescription = `Browse ${lib.count} ${lib.fullName} — ${lib.style.toLowerCase()} SVG icons, ${lib.license} licensed. Copy SVG, export PNG, or install ${lib.npm}. Free, no login.`;
const description =
  rawDescription.length > 158
    ? `Browse ${lib.count} ${lib.fullName} — ${lib.style.toLowerCase()} SVG icons, ${lib.license} licensed. Copy SVG, export PNG, install ${lib.npm}.`
    : rawDescription;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'IconStash', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Icon Libraries', item: `${SITE_URL}/library/` },
      { '@type': 'ListItem', position: 3, name: lib.fullName, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: lib.fullName,
    url: canonical,
    description: `Complete index of ${lib.count} ${lib.fullName} icon pages on IconStash, with SVG code, PNG export, and React snippets for every icon.`,
    isPartOf: { '@type': 'WebSite', name: 'IconStash', url: `${SITE_URL}/` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: lib.countNum,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  activeNav="library"
  bodyClass="pseo-page"
>
  <div class="hub-shell-main">
    <section class="hub-seo-band">
      <div class="pseo-document">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">IconStash</a> / <a href="/library/">Libraries</a> / <span>{lib.fullName}</span>
        </nav>

        <section class="hero">
          <div class="preview">
            <div class="hub-stats">
              <div class="hub-stat"><b>{lib.count}</b><span>Icons</span></div>
              <div class="hub-stat"><b>{lib.license.replace(' 1.0', '').replace(' 4.0', '')}</b><span>License</span></div>
              <div class="hub-stat"><b>{lib.style.split(' ')[0]}</b><span>Style</span></div>
              <div class="hub-stat"><b>{lib.grid}</b><span>Grid</span></div>
            </div>
          </div>
          <div>
            <h1>{lib.fullName}</h1>
            <p class="lead">
              {lib.count} {lib.license}-licensed {lib.style.toLowerCase()} icons
              {lib.grid === '24×24' ? ' on a 24×24 grid' : ` on a ${lib.grid} grid`}. {firstSentence(copy.about[1])}
            </p>
            <div class="cta">
              <a class="btn primary" href="/category/">Browse {lib.name} icons by category</a>
              <a class="btn" href="/compare/">Compare libraries</a>
            </div>
          </div>
        </section>
      </div>
    </section>

    <div class="workspace hub-explorer-stage">
      <ExplorerShell client:load initialLibrary={lib.slug} />
      <InspectorDrawer client:idle />
    </div>

    <section class="hub-seo-details">
      <div class="pseo-document">
        <p class="section-title">About {lib.fullName}</p>
        <div class="grid wide">
          <article class="card">
            <h2>What {lib.name} is</h2>
            {copy.about.map((p) => <p set:html={p} />)}
            <p>
              IconStash indexes the complete {lib.fullName} collection. You can search it alongside {allLibraries.length - 1} other libraries, preview any icon at any size and colour, and export SVG, PNG, React JSX, Vue, CSS, or an SVG sprite without installing a package or creating an account.
            </p>
          </article>
        </div>

        <p class="section-title">Install and use {lib.name}</p>
        <div class="grid wide">
          <article class="card">
            <h2>React</h2>
            <pre><code>npm install {lib.npm}</code></pre>
            <p>
              The official package ships each icon as a tree-shakeable component, so bundlers only include the icons you actually import. Open any {lib.name} icon on IconStash and the Code tab shows that icon's exact import statement and JSX.
            </p>
          </article>
          <article class="card">
            <h2>Plain SVG and other frameworks</h2>
            <p>
              You do not have to install anything. Every {lib.name} page lets you copy the raw SVG markup and paste it inline, which avoids a dependency entirely and gives you full control over colour, size, and stroke width.
            </p>
            <p>
              IconStash also exports PNG at six sizes, Vue and CSS snippets, and SVG sprites — all generated in the browser from the original vector.
            </p>
          </article>
        </div>

        <p class="section-title">When to choose {lib.name}</p>
        <div class="grid">
          <article class="card">
            <h2>Good fit</h2>
            <p set:html={copy.fit} />
          </article>
          <article class="card">
            <h2>Consider alternatives</h2>
            <p set:html={copy.alt} />
          </article>
          <article class="card">
            <h2>Licensing</h2>
            <p set:html={copy.lic} />
          </article>
        </div>

        <p class="section-title">{lib.name} compared to other libraries</p>
        <div class="grid wide">
          <article class="card">
            <table class="hub-table">
              <thead>
                <tr><th>Library</th><th>Icons</th><th>Style</th><th>License</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td><a href={`/library/${lib.slug}/`}>{lib.fullName}</a></td>
                  <td>{lib.count}</td>
                  <td>{lib.style}</td>
                  <td>{lib.license}</td>
                </tr>
                {peerRows.map((p) => (
                  <tr>
                    <td><a href={`/library/${p.slug}/`}>{p.fullName}</a></td>
                    <td>{p.count}</td>
                    <td>{p.style}</td>
                    <td>{p.license}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </article>
        </div>

        <p class="section-title">Browse {lib.name} by category</p>
        <div class="grid">
          <article class="card">
            <p class="hub-links">
              {CATEGORIES.map((cat, idx) => (
                <>
                  {idx > 0 && <span aria-hidden="true"> · </span>}
                  <a href={`/category/${cat.slug}/`}>{cat.name} icons</a>
                </>
              ))}
            </p>
          </article>
        </div>

        <p class="section-title">Frequently asked questions</p>
        <div class="grid wide">
          {faqs.map(([q, a]) => (
            <article class="card faq-item">
              <h2>{q}</h2>
              <p set:html={a} />
            </article>
          ))}
        </div>

        <p class="section-title">Explore other icon libraries</p>
        <div class="grid">
          <article class="card">
            <p class="hub-links">
              {otherLibs.map((l, idx) => (
                <>
                  {idx > 0 && <span aria-hidden="true"> · </span>}
                  <a href={`/library/${l.slug}/`}>{l.fullName}</a>
                </>
              ))}
            </p>
          </article>
        </div>

        <Footer />
      </div>
    </section>
  </div>

  <Fragment slot="overlays">
    <CollectionsTray client:idle />
    <CompareModal client:idle />
    <SvgDrawModal client:idle />
  </Fragment>
</BaseLayout>
