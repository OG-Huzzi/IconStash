---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const title = 'Page Not Found (404) | IconStash';
const description =
  'The requested page could not be found on IconStash. Browse 134,701 free vector SVG icons across 28 open-source icon sets.';
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex, follow"
  activeNav="none"
  showSearch={false}
  showSidebarToggle={false}
>
  <div class="hub-shell-main">
    <main class="not-found-wrap">
      <div class="code-tag">404 &middot; Not Found</div>
      <h1>Page Not Found</h1>
      <p>
        The page or icon you're looking for might have been moved or updated in our 134,701 vector icon database.
      </p>

      <div class="nav-grid">
        <a href="/library/" class="nav-card">Browse 28 Libraries &rarr;</a>
        <a href="/category/" class="nav-card">Browse 16 Categories &rarr;</a>
        <a href="/style/" class="nav-card">Browse 7 Styles &rarr;</a>
        <a href="/compare/" class="nav-card">Compare Icon Sets &rarr;</a>
        <a href="/articles/" class="nav-card">Developer Guides &rarr;</a>
        <a href="/stats/" class="nav-card">Library Statistics &rarr;</a>
      </div>

      <a href="/" class="btn-primary-404">Search All 134K+ Icons &rarr;</a>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .not-found-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 24px;
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
  }

  .code-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--neon-blue);
    background: rgba(193, 221, 45, 0.1);
    border: 1px solid rgba(193, 221, 45, 0.25);
    padding: 4px 12px;
    border-radius: 6px;
    margin-bottom: 20px;
  }

  .not-found-wrap h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .not-found-wrap p {
    color: var(--text-secondary);
    font-size: 17px;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    margin-bottom: 32px;
  }

  .nav-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .nav-card:hover {
    border-color: var(--neon-blue);
    transform: translateY(-2px);
  }

  .btn-primary-404 {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-weight: 800;
    font-size: 15px;
    padding: 14px 32px;
    border-radius: 8px;
    display: inline-block;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
  }

  .btn-primary-404:hover {
    background: var(--btn-primary-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .nav-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
