---
const FOOTER_LIBRARIES = [
  { slug: 'lucide', label: 'Lucide' },
  { slug: 'tabler', label: 'Tabler' },
  { slug: 'phosphor', label: 'Phosphor' },
  { slug: 'material', label: 'Material Design' },
  { slug: 'remix', label: 'Remix' },
  { slug: 'iconoir', label: 'Iconoir' },
  { slug: 'heroicons', label: 'Heroicons' },
  { slug: 'bootstrap', label: 'Bootstrap Icons' },
  { slug: 'feather', label: 'Feather' },
  { slug: 'mingcute', label: 'MingCute' },
  { slug: 'solar', label: 'Solar' },
  { slug: 'octicons', label: 'Octicons' },
  { slug: 'cssgg', label: 'css.gg' },
  { slug: 'radix', label: 'Radix' },
  { slug: 'antdesign', label: 'Ant Design' },
  { slug: 'fluent', label: 'Fluent UI' },
  { slug: 'carbon', label: 'Carbon' },
  { slug: 'ionicons', label: 'Ionicons' },
  { slug: 'eva', label: 'Eva' },
  { slug: 'boxicons', label: 'Boxicons' },
  { slug: 'materialsymbols', label: 'Material Symbols' },
  { slug: 'materialsymbolslight', label: 'Material Symbols Light' },
  { slug: 'iconparkoutline', label: 'IconPark Outline' },
  { slug: 'iconparksolid', label: 'IconPark Solid' },
  { slug: 'hugeicons', label: 'Huge Icons' },
  { slug: 'pixelarticons', label: 'Pixel Art' },
  { slug: 'linemd', label: 'Line MD' },
  { slug: 'simpleicons', label: 'Simple Icons' },
] as const;
---

<footer class="home-footer">
  <div class="footer-container">
    <div class="footer-left">
      <a class="footer-logo" href="/" aria-label="IconStash.io home">
        <svg class="logo-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2 21 7v10l-9 5-9-5V7l9-5Z" />
          <path d="m8 9 4-2 4 2v6l-4 2-4-2V9Z" />
        </svg>
        <span class="logo-text">IconStash<span class="logo-io">.io</span></span>
      </a>
      <p class="footer-tagline">
        Instant, browser-based icon search engine. Unify 28+ open-source icon libraries into a single lightning-fast search.
      </p>
    </div>

    <div class="footer-right">
      <div class="footer-line">
        This website is offered to you by
        <a href="https://greatsoftwarecompany.com" target="_blank" rel="noopener" class="footer-link">Great Software Company</a>
        in collaboration with Huzzi.
      </div>
      <div class="footer-line">
        <a href="/about/" class="footer-link">About</a> &middot;
        <a href="/contact/" class="footer-link">Contact</a> &middot;
        <a href="/terms/" class="footer-link">Terms of Service</a> &middot;
        <a href="/privacy/" class="footer-link">Privacy Policy</a> &middot;
        <a href="/stats/" class="footer-link">Library Stats</a> &middot;
        <a href="/articles/" class="footer-link">Articles</a>
      </div>
      <div class="footer-line">
        Developers:
        <a href="/api/" class="footer-link">Free API &amp; MCP</a> &middot;
        <a href="/api/v1/manifest.json" class="footer-link">manifest.json</a>
      </div>
      <div class="footer-line">
        Browse:
        <a href="/library/" class="footer-link">Icon libraries</a> &middot;
        <a href="/category/" class="footer-link">Icon categories</a> &middot;
        <a href="/style/" class="footer-link">Icon styles</a> &middot;
        <a href="/compare/" class="footer-link">Comparisons</a> &middot;
        <a href="/alternatives/" class="footer-link">Alternatives</a> &middot;
        <a href="/icons-for/" class="footer-link">By framework</a> &middot;
        <a href="/seo/" class="footer-link">HTML Sitemap</a>
      </div>
      <div class="footer-line">
        Libraries:{' '}
        {FOOTER_LIBRARIES.map((lib, idx) => (
          <>
            {idx > 0 && ' · '}
            <a href={`/library/${lib.slug}/`} class="footer-link">{lib.label}</a>
          </>
        ))}
      </div>
      <div class="footer-line">
        Questions? Feedback? Love letters? Contact us at
        <a href="mailto:heybro@iconstash.io" class="footer-link">heybro@iconstash.io</a>
      </div>
      <div class="footer-line">&copy; 2026 IconStash.io. All rights reserved.</div>
    </div>
  </div>
</footer>
